# Required in production
DATABASE_URL=postgresql://bbadmin:PASSWORD@SERVER.postgres.database.azure.com:5432/buildbouncer?sslmode=require
SESSION_SECRET=            # 32+ random chars (openssl rand -hex 32)
SIGNING_KEY=               # 32+ random chars; signs SBOMs/evidence (keep stable!)
ADMIN_EMAIL=admin@example.com   # first administrator, created on first start
ADMIN_PASSWORD=            # >=10 chars, letters+numbers
PUBLIC_URL=https://YOUR-APP.azurewebsites.net
# Optional
ALLOW_SIGNUP=true          # allow self-signup (role below)
SIGNUP_ROLE=operator
SIGNUP_CODE=               # require an invite code at signup
SCAN_CONCURRENCY=2
# Local dev with no Postgres: leave DATABASE_URL empty (embedded PGLite, dev only)
